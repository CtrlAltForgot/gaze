+// Round the given time up to the next tick of a clock with the given phase and
+// interval.
+static uint64_t snap_to_next_tick(uint64_t value,
+                                  uint64_t phase,
+                                  uint64_t interval) {
+  if (value <= phase) {
+    return phase;
+  }
+  uint64_t remainder = (value - phase) % interval;
+  if (remainder == 0) {
+    return value;
+  }
+  return value + (interval - remainder);
+}
